<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:divider="@color/transparent"
    app:allowDividerBelow="false">
		
    <io.legado.app.lib.prefs.Preference
        android:icon="@drawable/ic_cfg_source"
        android:key="bookSourceManage"
        android:title="书源管理"
        app:iconSpaceReserved="false" />
				
    <!-- <io.legado.app.lib.prefs.SwitchPreference
        android:defaultValue="false"
        android:icon="@drawable/ic_cfg_web"
        android:key="webService"
        android:title="网页阅读"
        app:allowDividerBelow="false"
        app:iconSpaceReserved="false" />-->

    <io.legado.app.lib.prefs.Preference
        android:icon="@drawable/ic_cfg_backup"
        android:key="web_dav_setting"
        android:title="备份配置"
        app:iconSpaceReserved="false" />

    <io.legado.app.lib.prefs.Preference
        android:icon="@drawable/ic_cfg_other"
        android:key="setting"
        android:title="其他配置"
        app:iconSpaceReserved="false" />

    <!-- ========== 启动器模式开关 ========== -->
    <io.legado.app.lib.prefs.SwitchPreference
        android:defaultValue="false"
        android:icon="@drawable/ic_cfg_other"
        android:key="launcher_mode"
        android:title="桌面模式"
        app:allowDividerBelow="false"
        app:iconSpaceReserved="false" />

    <io.legado.app.lib.prefs.Preference
        android:icon="@drawable/ic_5"
        android:key="system_settings"
        android:title="安卓设置"
        app:iconSpaceReserved="false" />
				
    <io.legado.app.lib.prefs.Preference
        android:icon="@drawable/ic_6"
        android:key="wallpaper_generator"
        android:title="统计壁纸"
        app:iconSpaceReserved="false" />

    <io.legado.app.lib.prefs.SwitchPreference
        android:icon="@drawable/ic_6"
        android:defaultValue="true"
        android:key="einkDitherImage"
        android:title="图片抖动"
        app:iconSpaceReserved="false" />

    <io.legado.app.lib.prefs.Preference
        android:icon="@drawable/ic_cfg_about"
        android:key="about"
        android:title="关于软件"
        app:iconSpaceReserved="false" />

</androidx.preference.PreferenceScreen>